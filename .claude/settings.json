{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "slip prime"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "slip release --session \"$CLAUDE_SESSION_ID\""
          }
        ]
      }
    ]
  }
}
